{
  "name": "dsh-peak-price-guard",
  "version": "1.1.0",
  "description": "DeepSeek Harness plugin: intercepts DeepSeek API requests during Beijing peak hours (09:00-12:00 / 14:00-18:00, 2x price) and shows a two-button confirmation modal. Prompts once per session per N hours.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "deepseek",
    "peak-hours",
    "pricing",
    "cost-guard"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bobbychina32747/dsh-peak-price-guard.git"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
